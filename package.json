{
  "name": "neurozy-voice-to-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace neurozy-voice-to-website-client -- --host 0.0.0.0 --port 3000 --strictPort",
    "build": "npm run build --workspace neurozy-voice-to-website-client",
    "preview": "npm run preview --workspace neurozy-voice-to-website-client -- --host 0.0.0.0 --port 4173 --strictPort",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['dist','client/dist','server.js']) fs.rmSync(p,{recursive:true,force:true})\"",
    "lint": "npm run lint --workspace neurozy-voice-to-website-client"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
